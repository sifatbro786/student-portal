NODE_ENV=development
APP_URL=http://localhost:3000

# Single-node replica set (rs0) is required for transactions (PRD §6)
MONGODB_URI=mongodb://127.0.0.1:27017/tm?replicaSet=rs0
# Dev only, if your local mongod is NOT a replica set (ignored in production):
# MONGO_TRANSACTIONS=off

# >= 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Must be an absolute path OUTSIDE the project directory (PRD §8).
# Windows dev example: UPLOAD_ROOT=E:/Works/Tauhid Mostafa/tm-data/uploads
UPLOAD_ROOT=/var/www/tm-data/uploads
PUBLIC_MEDIA_BASE=/media

# Mail (P3) — Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tauhid Mostafa <you@gmail.com>"
ADMIN_NOTIFY_EMAILS=
