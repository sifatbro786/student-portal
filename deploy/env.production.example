# Production .env on the VPS: /var/www/tm/app/.env   →   chmod 600 .env
# Never commit this file. Generate secrets on the server, never reuse the dev ones.
NODE_ENV=production
APP_URL=https://tm-english.org

# MongoDB — Atlas (replica set, transactions OK): Atlas → Connect → Drivers.
# Network Access must allow the VPS IP. Keep the database name in the path (/tm).
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tm?retryWrites=true&w=majority&appName=Cluster0"

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Outside the app folder (PRD §8). Nginx serves UPLOAD_ROOT/public at /media.
UPLOAD_ROOT=/var/www/tm/data/uploads
PUBLIC_MEDIA_BASE=/media

# Gmail with 2-Step Verification ON → App passwords → 16 letters, no spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tauhid Mostafa <same-as-SMTP_USER@gmail.com>"
ADMIN_NOTIFY_EMAILS=

# Backups (deploy/backup.sh): off-site copy with rclone, e.g. gdrive:tm-backups
BACKUP_DIR=/var/www/tm/backups
RCLONE_REMOTE=
